{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "万象谱",
  "version": "0.3.5",
  "identifier": "com.loreweft.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "万象谱 - 智能小说创作引擎",
        "width": 1400,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "maximized": true,
        "skipTaskbar": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/python/": "python/",
      "resources/backend/": "backend/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer-template.nsi",
        "languages": ["English", "SimpChinese"],
        "customLanguageFiles": {
          "English": "installer/languages/English.nsh",
          "SimpChinese": "installer/languages/SimpChinese.nsh"
        },
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1QTJGNjMxMDVBOUM1QTAKUldTZ3hha0ZNZmFpSmFaNnFjUUN5VVMzODlkdERjcmFiWTJCLzdmeUprejNtWktEcmgzSFJiTjcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
