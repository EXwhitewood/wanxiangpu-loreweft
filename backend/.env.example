# Canonical SQLite database. Keep all three paths on the same file.
DATABASE_URL=sqlite+aiosqlite:///data/loreweft.db
SQLITE_PATH=data/loreweft.db
SQLITE_FTS_PATH=data/loreweft.db

# Writable JSON/text artifacts (settings, context ledgers, diagnostics).
DATA_DIR=data

SECRET_KEY=change-me-in-production
DEBUG=false
LLM_TRUST_ENV_PROXY=false
READER_CORPUS_MODE=off
